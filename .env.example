# =========================
# Database
# =========================
# Local dev: run `docker compose up -d` then use:
DATABASE_URL="postgresql://elp:elp_dev_password@localhost:5432/elp?schema=public"
DIRECT_URL="postgresql://elp:elp_dev_password@localhost:5432/elp?schema=public"

# =========================
# Next.js / Auth
# =========================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"

# =========================
# AI / LLM (Phase 4)
# =========================
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Embeddings provider (Phase 3)
EMBEDDINGS_PROVIDER="voyage"
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3-large"
EMBEDDING_DIM="1024"

# =========================
# AI Service
# =========================
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN="dev-internal-token-change-me"

# =========================
# Storage (S3-compatible)
# =========================
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="elp-documents"

# =========================
# App config
# =========================
DEFAULT_LOCALE="ar"
SUPPORTED_LOCALES="ar,en"
NODE_ENV="development"
